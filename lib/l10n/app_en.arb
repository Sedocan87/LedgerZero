  "faqBudgetingQ": "How does envelope budgeting work?",
  "@faqBudgetingQ": {
    "description": "FAQ question"
  },
  "faqBudgetingA": "You give all the money you have a job: assign it to categories until To Be Budgeted is zero. You spend from what a category has available. If you overspend, move money from another category to cover it.",
  "@faqBudgetingA": {
    "description": "FAQ answer"
  },
  "faqSafeQ": "Is my data safe?",
  "@faqSafeQ": {
    "description": "FAQ question"
  },
  "faqSafeA": "Your data is stored only on your device, in a database encrypted with AES-256 and unlocked with your master password. If you turn on sync, it is encrypted with your sync passphrase before it leaves the device. There are no LedgerZero servers, no tracking and no analytics.",
  "@faqSafeA": {
    "description": "FAQ answer"
  },
  "faqSyncQ": "How do I sync between devices?",
  "@faqSyncQ": {
    "description": "FAQ question"
  },
  "faqSyncA": "Open Settings > Sync Settings, choose Google Drive and sign in. On the first device you set a sync passphrase; enter the same passphrase on every other device. Keep it safe: it cannot be recovered.",
  "@faqSyncA": {
    "description": "FAQ answer; menu names must match the settings labels"
  },
  "faqOfflineQ": "Can I use the app offline?",
  "@faqOfflineQ": {
    "description": "FAQ question"
  },
  "faqOfflineA": "Yes. Everything works offline. Sync catches up automatically when you are back online.",
  "@faqOfflineA": {
    "description": "FAQ answer"
  },
  "faqPasswordQ": "What if I forget my master password?",
  "@faqPasswordQ": {
    "description": "FAQ question"
  },
  "faqPasswordA": "Unlock with the recovery key you wrote down during setup, then choose a new password. Without the password and the recovery key nobody can unlock your data, not even the developer.",
  "@faqPasswordA": {
    "description": "FAQ answer"
  },
  "faqBackupQ": "How do backups work?",
  "@faqBackupQ": {
    "description": "FAQ question"
  },
  "faqBackupA": "Settings > Backup & Export creates a backup file that is always encrypted with a backup password you choose. Without that password the backup cannot be restored. CSV and JSON exports are readable copies and are not encrypted.",
  "@faqBackupA": {
    "description": "FAQ answer; menu names must match the settings labels"
  },
  "faqImportQ": "Can I import from YNAB or my bank?",
  "@faqImportQ": {
    "description": "FAQ question"
  },
  "faqImportA": "Yes. Settings > YNAB Migration imports nYNAB CSV exports and YNAB 4 budgets. Settings > Import CSV reads the CSV export of your bank.",
  "@faqImportA": {
    "description": "FAQ answer; menu names must match the settings labels"
  },
  "guideStartTitle": "1. Getting started",
  "@guideStartTitle": {
    "description": "User guide section title"
  },
  "guideStartBody": "LedgerZero uses zero-based envelope budgeting: before you spend money, you give it a job by assigning it to a category.",
  "@guideStartBody": {
    "description": "User guide section text"
  },
  "guideAccountsTitle": "2. Accounts",
  "@guideAccountsTitle": {
    "description": "User guide section title"
  },
  "guideAccountsBody": "Add the accounts you pay from (checking, savings, credit card, cash) with their current balance. That money is what you can budget: it appears as To Be Budgeted.",
  "@guideAccountsBody": {
    "description": "User guide section text"
  },
  "guideBudgetTitle": "3. Budgeting",
  "@guideBudgetTitle": {
    "description": "User guide section title"
  },
  "guideBudgetBody": "On the Budget screen, tap a category's budgeted amount to assign money. Keep going until To Be Budgeted is zero. Income without a category adds to To Be Budgeted.",
  "@guideBudgetBody": {
    "description": "User guide section text"
  },
  "guideTransactionsTitle": "4. Transactions",
  "@guideTransactionsTitle": {
    "description": "User guide section title"
  },
  "guideTransactionsBody": "Record each expense with a payee and a category; it reduces what the category has available. Quick Add lets you type a transaction in one line, and rules categorise imported transactions automatically.",
  "@guideTransactionsBody": {
    "description": "User guide section text"
  },
  "guideOverspendingTitle": "5. Overspending",
  "@guideOverspendingTitle": {
    "description": "User guide section title"
  },
  "guideOverspendingBody": "When a category's available amount turns red, you have spent more than you budgeted. Move money from another category to cover it.",
  "@guideOverspendingBody": {
    "description": "User guide section text"
  },
  "guideReconcileTitle": "6. Reconciling",
  "@guideReconcileTitle": {
    "description": "User guide section title"
  },
  "guideReconcileBody": "Now and then, compare an account with your bank statement using Reconcile Account on the account screen. Cleared transactions are marked as reconciled, and any difference is recorded as an adjustment.",
  "@guideReconcileBody": {
    "description": "User guide section text"
  },
  "guideSyncTitle": "7. Sync and backups",
  "@guideSyncTitle": {
    "description": "User guide section title"
  },
  "guideSyncBody": "Sync keeps your phones and tablets up to date through your own Google Drive, end-to-end encrypted with your sync passphrase. Create encrypted backups regularly in Settings > Backup & Export.",
  "@guideSyncBody": {
    "description": "User guide section text"
  },
